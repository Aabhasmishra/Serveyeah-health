# ServeYeah Health Frontend Environment Configuration
# Copy this file to .env and adjust values as needed

# API Base URL (Expo public env vars must start with EXPO_PUBLIC_)
# Do NOT include trailing slash
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Development test IDs (for local development only)
# These allow the app to work without authentication during development
EXPO_PUBLIC_DEV_USER_ID=U0018
EXPO_PUBLIC_DEV_WORKER_ID=W0001
EXPO_PUBLIC_DEV_CAMP_ID=C0001